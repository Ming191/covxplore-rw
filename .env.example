# Copy this to .env and fill in your values.

# AkaUT Spring Boot REST API (default: http://localhost:8080)
AKAUT_BASE_URL=http://localhost:8080

# LLM provider selection: deepseek (default, backward compatible) or kimchi
LLM_PROVIDER=deepseek

# DeepSeek API credentials (via LiteLLM)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Kimchi API credentials (OpenAI-compatible endpoint via LiteLLM)
# Set LLM_PROVIDER=kimchi to use these values.
KIMCHI_API_KEY=sk-...
KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1
KIMCHI_MODEL=kimi-k2.6

# COV127 generation. MAX_TOKENS is intentionally omitted: the provider/model
# decides its completion limit while Covxplore records actual token usage.
STRATEGY=hybrid
STATEMENT_TARGET=1.0
BRANCH_TARGET=1.0
SCHEDULER_MODE=rule
WALL_TIME_MINUTES=30
MAX_LLM_CALLS=15
MAX_SYMBOLIC_ATTEMPTS=30
MAX_TEST_EXECUTIONS=30
REQUEST_TIMEOUT_SEC=120

# COV127 experiment repetitions per function
ABLATION_REPEAT=3
