# Copy this to .env and fill in your values.

# AkaUT Spring Boot REST API (default: http://localhost:8080)
AKAUT_BASE_URL=http://localhost:8080

# LLM provider selection: deepseek (default, backward compatible) or kimchi
LLM_PROVIDER=deepseek

# DeepSeek API credentials (via LiteLLM)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Kimchi API credentials (OpenAI-compatible endpoint via LiteLLM)
# Set LLM_PROVIDER=kimchi to use these values.
KIMCHI_API_KEY=sk-...
KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1
KIMCHI_MODEL=kimi-k2.6

# Optional local Langfuse observability (start infra/langfuse/docker-compose.yml first)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-covxplore-local
LANGFUSE_SECRET_KEY=sk-lf-covxplore-local

# Generation loop
MAX_ITERATIONS=15
MIN_SUITE_SIZE=1
REQUEST_TIMEOUT_SEC=120

# Ablation study
DEFAULT_PROMPT_VARIANT=full
ABLATION_REPEAT=3
